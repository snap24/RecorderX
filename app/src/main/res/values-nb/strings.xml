    <!-- Auto-generated translations for all UI & guides -->
    <string name="title_swipe_here">SWIPE HER</string>
    <string name="title_recorder">OPPTAKER</string>
    <string name="saved_in_path">Lagret i: /Movies/RecorderX</string>
    <string name="guide_codec_desc">H.264 (mest kompatibel med andre spillere), H.265 (svært effektiv komprimering) eller AV1 (Neste generasjons høy kvalitet).</string>
    <string name="guide_orientation_desc">Lås sideforhold for videoopptak til Auto, Portrett (vertikalt) eller Landskap (horisontalt).</string>
    <string name="guide_resolution_desc">NATIVE tar opp med skjermens eksakte oppløsning. 4K, 2K, FHD, HD og SD låseopptak til standard dimensjoner.</string>
    <string name="guide_fps_desc">Rekkevidde på 24-60 FPS for standard videojevnhet. Enheter med høy oppdateringsfrekvens støtter 90–120 FPS for ultrajevn spillavspilling.</string>
    <string name="guide_bitrate_desc">Angir datahastighet i Mbps. Høyere verdier fanger opp skarpere detaljer under bevegelse, men resulterer i større videofiler.</string>
    <string name="guide_bitrate_mode_desc">VBR (Variable Bitrate) skalerer datahastigheten dynamisk for å spare lagring. CBR (Constant Bitrate) fremtvinger høye detaljer uavhengig av bevegelse.</string>
    <string name="guide_audio_source_desc">Velg mellom Silence (AV), Mikrofon (MIC), System Internal Loopback (SYS) eller MIX (SYS+MIC) for å ta opp begge sammen.</string>
    <string name="guide_audio_quality_desc">Juster lydsamplingsfrekvens og kodingsbithastighet. Høyere nivåer gir renere, støyfrie lyddetaljer.</string>
    <string name="dialog_auto_orientation_title">⚠ Advarsel om automatisk orientering</string>
    <string name="dialog_auto_orientation_message">Automatisk orientering er en gimmick og vil forringe opptakskvaliteten din.\n\nAndroid roterer dynamisk den virtuelle skjermen midt i opptak, noe som ofte forårsaker uoverensstemmelser i oppløsningen, svarte søyler og ustabilitet i koderen.\n\nVi anbefaler på det sterkeste å velge Portrett eller Landskap manuelt for å matche primærretningen til appen du har tenkt å ta opp best – dette gir mest konsistent utdata.</string>
    <string name="dialog_auto_orientation_button_timer">Jeg forstår (%d)</string>
    <string name="dialog_auto_orientation_button">Jeg forstår</string>
    <string name="dialog_overlay_permission_title">Overleggstillatelse kreves</string>
    <string name="dialog_overlay_permission_message">For å vise den flytende kontrollerboblen trenger RecorderX tillatelse til å vises over andre apper. Vennligst gi det på neste skjermbilde.</string>
    <string name="btn_grant">Gi tillatelse</string>
    <string name="btn_cancel">Avbryt</string>
    <string name="dialog_av1_software_title">⚠ AV1-programvarekoding</string>
    <string name="dialog_av1_software_message">Maskinvare AV1-koding støttes ikke på denne enheten.\n\nOpptaket vil bli utført med programvare AV1 (CPU-koding). Dette kan føre til økt CPU-bruk, høyere batteriforbruk og potensielle bildefall ved høyere oppløsninger.</string>
    <string name="dialog_av1_software_button">JEG FORSTÅR</string>
