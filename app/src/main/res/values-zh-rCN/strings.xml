    <!-- Auto-generated translations for all UI & guides -->
    <string name="title_swipe_here">在这里滑动</string>
    <string name="title_recorder">录音机</string>
    <string name="saved_in_path">保存在：/Movies/RecorderX</string>
    <string name="guide_codec_desc">H.264（与其他播放器最兼容）、H.265（高效压缩）或 AV1（下一代高质量）。</string>
    <string name="guide_orientation_desc">将录制的视频宽高比锁定为自动、纵向（垂直）或横向（水平）。</string>
    <string name="guide_resolution_desc">NATIVE 以屏幕的精确分辨率进行捕获。 4K、2K、FHD、HD 和 SD 将捕获锁定为标准尺寸。</string>
    <string name="guide_fps_desc">标准视频流畅度范围为 24-60 FPS。高刷新率设备支持 90-120 FPS，实现超流畅的游戏播放。</string>
    <string name="guide_bitrate_desc">指定数据速度（以 Mbps 为单位）。较高的值在运动过程中捕捉到更清晰的细节，但会导致视频文件更大。</string>
    <string name="guide_bitrate_mode_desc">VBR（可变比特率）动态调整数据速率以节省存储空间。无论运动如何，CBR（恒定比特率）都会强制提供高细节。</string>
    <string name="guide_audio_source_desc">选择静音 (OFF)、麦克风 (MIC)、系统内部环回 (SYS) 或混合 (SYS+MIC) 将两者一起录制。</string>
    <string name="guide_audio_quality_desc">调整音频采样率和编码比特率。更高的层可提供更干净、无噪音的声音细节。</string>
    <string name="dialog_auto_orientation_title">⚠ 自动方向警告</string>
    <string name="dialog_auto_orientation_message">自动方向是一个噱头，会降低您的录制质量。\n\nAndroid 在录制过程中动态旋转虚拟显示器，通常会导致分辨率不匹配、黑条和编码器不稳定。\n\n我们强烈建议手动选择纵向或横向以匹配您要录制的应用程序的主要方向 - 这会产生最佳、最一致的输出。</string>
    <string name="dialog_auto_orientation_button_timer">我明白了 (%d)</string>
    <string name="dialog_auto_orientation_button">我明白</string>
    <string name="dialog_overlay_permission_title">需要叠加权限</string>
    <string name="dialog_overlay_permission_message">要显示浮动控制器气泡，RecorderX 需要在其他应用程序上显示的权限。请在下一个屏幕上授予它。</string>
    <string name="btn_grant">格兰特</string>
    <string name="btn_cancel">取消</string>
    <string name="dialog_av1_software_title">⚠ AV1 软件编码</string>
    <string name="dialog_av1_software_message">此设备不支持硬件 AV1 编码。\n\n将使用软件 AV1（CPU 编码）进行录制。这可能会导致 CPU 使用率增加、电池消耗增加以及在高分辨率下可能出现帧丢失。</string>
