    <!-- Auto-generated translations for all UI & guides -->
    <string name="title_swipe_here">PASA HEMEN</string>
    <string name="title_recorder">GRABATZAILEA</string>
    <string name="saved_in_path">Hemen gordeta: /Movies/RecorderX</string>
    <string name="guide_codec_desc">H.264 (Beste erreproduzitzaile batzuekin bateragarriena), H.265 (Konpresio eraginkorra) edo AV1 (Hurrengo belaunaldiko kalitate handikoa).</string>
    <string name="guide_orientation_desc">Blokeatu grabatutako bideoaren aspektu-erlazioak Auto, Erretratua (bertikala) edo Paisaia (horizontala) moduan.</string>
    <string name="guide_resolution_desc">NATIVE-k pantailaren bereizmen zehatzean ateratzen ditu. 4K, 2K, FHD, HD eta SD blokeoa harrapatzea neurri estandarretan.</string>
    <string name="guide_fps_desc">24-60 FPS bitartekoa bideoaren leuntasun estandarra lortzeko. Freskatze tasa handiko gailuek 90-120 FPS onartzen dituzte joko oso leunak erreproduzitzeko.</string>
    <string name="guide_bitrate_desc">Datuen abiadura Mbps-tan zehazten du. Balio altuagoek xehetasun zorrotzagoak jasotzen dituzte mugimenduan zehar, baina bideo-fitxategi handiagoak sortzen dituzte.</string>
    <string name="guide_bitrate_mode_desc">VBR (Variable Bitrate) datu-tasa dinamikoki eskalatzen du biltegia aurrezteko. CBR (Bitrate Konstantea) xehetasun handiak behartzen ditu mugimendua edozein dela ere.</string>
    <string name="guide_audio_source_desc">Aukeratu Isiltasuna (OFF), Mikrofonoa (MIC), Sistemaren barneko loopback (SYS) edo MIX (SYS+MIC) biak batera grabatzeko.</string>
    <string name="guide_audio_quality_desc">Doitu audio lagin-tasa eta kodetze-bit-tasa. Maila altuagoek soinu xehetasun garbiagoak eta zaratarik gabekoak eskaintzen dituzte.</string>
    <string name="dialog_auto_orientation_title">⚠ Orientazio automatikoaren abisua</string>
    <string name="dialog_auto_orientation_message">Orientazio automatikoa trikimailu bat da eta zure grabazioaren kalitatea hondatuko du.\n\nAndroid-ek pantaila birtuala grabazio erdian modu dinamikoan biratzen du, eta askotan bereizmen-desegokiak, barra beltzak eta kodegailuaren ezegonkortasuna eragiten ditu.\n\nErretratua edo Horizontala eskuz hautatzea gomendatzen dugu grabatu nahi duzun aplikazioaren orientazio nagusiarekin bat etor dadin; honek irteerarik onena eta koherenteena sortzen du.</string>
    <string name="dialog_auto_orientation_button_timer">Ulertzen dut (%d)</string>
    <string name="dialog_auto_orientation_button">Ulertzen dut</string>
    <string name="dialog_overlay_permission_title">Gainjartzeko baimena behar da</string>
    <string name="dialog_overlay_permission_message">Kontrolagailu flotagarria bistaratzeko, RecorderX-ek beste aplikazio batzuen gainean bistaratzeko baimena behar du. Mesedez, eman hurrengo pantailan.</string>
    <string name="btn_grant">Eman</string>
    <string name="btn_cancel">Utzi</string>
    <string name="dialog_av1_software_title">⚠ AV1 softwarearen kodeketa</string>
    <string name="dialog_av1_software_message">Hardwarearen AV1 kodeketa ez da onartzen gailu honetan.\n\nGrabaketa AV1 softwarea (CPU kodeketa) erabiliz egingo da. Honek PUZaren erabilera areagotzea, bateria-kontsumo handiagoa eta fotograma jaitsi daitezke bereizmen handiagoetan.</string>
    <string name="dialog_av1_software_button">ULERTZEN DUT</string>
    <string name="dialog_language_title">HAUTATU HIZKUNTZA (80)</string>
