    <!-- Auto-generated translations for all UI & guides -->
    <string name="title_swipe_here">SWIPE kene</string>
    <string name="title_recorder">REKAMAN</string>
    <string name="saved_in_path">Disimpen ing: /Film/RecorderX</string>
    <string name="guide_codec_desc">H.264 (Paling kompatibel karo pemain liyane), H.265 (Highly komprèsi efisien), utawa AV1 (Sabanjure-generasi kualitas dhuwur).</string>
    <string name="guide_orientation_desc">Kunci rasio aspek video sing direkam dadi Otomatis, Potret (vertikal), utawa Lanskap (horizontal).</string>
    <string name="guide_resolution_desc">NATIVE njupuk ing resolusi pas layar. Jupuk kunci 4K, 2K, FHD, HD, lan SD menyang ukuran standar.</string>
    <string name="guide_fps_desc">Kisaran 24-60 FPS kanggo kelancaran video standar. Piranti tingkat refresh dhuwur ndhukung 90-120 FPS kanggo muter maneh game sing mulus.</string>
    <string name="guide_bitrate_desc">Nemtokake kacepetan data ing Mbps. Nilai sing luwih dhuwur njupuk rincian sing luwih cetha sajrone gerakan nanging ngasilake file video sing luwih gedhe.</string>
    <string name="guide_bitrate_mode_desc">VBR (Variable Bitrate) kanthi dinamis ngukur tingkat data kanggo ngirit panyimpenan. CBR (Constant Bitrate) meksa rincian sing dhuwur tanpa preduli saka gerakan.</string>
    <string name="guide_audio_source_desc">Pilih saka Silence (OFF), Microphone (MIC), System Internal Loopback (SYS), utawa MIX (SYS+MIC) kanggo ngrekam loro-lorone.</string>
    <string name="guide_audio_quality_desc">Nyetel tingkat sampel audio lan bitrate enkoding. Tingkat sing luwih dhuwur nyedhiyakake rincian swara sing luwih resik lan tanpa gangguan.</string>
    <string name="dialog_auto_orientation_title">⚠ Peringatan Orientasi Otomatis</string>
    <string name="dialog_auto_orientation_message">Auto Orientation minangka gimmick lan bakal ngrusak kualitas rekaman sampeyan.\n\nAndroid kanthi dinamis muter tampilan virtual ing tengah rekaman, asring nyebabake resolusi ora cocog, garis ireng, lan ora stabil encoder.\n\nSampeyan banget nyaranake milih Potret utawa Lanskap kanthi manual supaya cocog karo orientasi utama aplikasi sing arep direkam — iki ngasilake output sing paling apik lan konsisten.</string>
    <string name="dialog_auto_orientation_button_timer">Aku Ngerti (%d)</string>
    <string name="dialog_auto_orientation_button">Aku Ngerti</string>
    <string name="dialog_overlay_permission_title">Ijin Overlay Dibutuhake</string>
    <string name="dialog_overlay_permission_message">Kanggo nampilake gelembung pengontrol sing ngambang, RecorderX mbutuhake ijin kanggo nampilake aplikasi liyane. Mangga wenehake ing layar sabanjure.</string>
    <string name="btn_grant">Idini</string>
    <string name="btn_cancel">Batal</string>
    <string name="dialog_av1_software_title">⚠ Encoding Piranti Lunak AV1</string>
    <string name="dialog_av1_software_message">Encoding AV1 hardware ora didhukung ing piranti iki.\n\nNgrekam bakal ditindakake nggunakake Software AV1 (encoding CPU). Iki bisa nyebabake panggunaan CPU saya tambah, konsumsi baterei sing luwih dhuwur, lan kemungkinan pigura mudhun ing resolusi sing luwih dhuwur.</string>
