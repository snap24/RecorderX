    <string name="guide_codec_desc">H.264 (Kacha dakọtara na ndị ọzọ egwuregwu), H.265 (Highly ịrụ ọrụ nke ọma mkpakọ), ma ọ bụ AV1 (ọgbọ-ọgbọ elu àgwà).</string>
    <string name="guide_orientation_desc">Mkpọchi akụkụ vidiyo edekọtara na akpaaka, Eserese ( vetikal), ma ọ bụ Okirikiri ala (nke kwụ ọtọ).</string>
    <string name="guide_resolution_desc">Native na-ese na mkpebi ihuenyo gị kpọmkwem. 4K, 2K, FHD, HD, na njide mkpọchi SD na nha ọkọlọtọ.</string>
    <string name="guide_fps_desc">Oke nke 24-60 FPS maka ire ụtọ vidiyo ọkọlọtọ. Ngwa ume ọhụrụ dị elu na-akwado 90-120 FPS maka ịkpọghachi egwuregwu dị nro.</string>
    <string name="guide_bitrate_desc">Na-akọwapụta ọsọ data na Mbps. Ụkpụrụ dị elu na-ejide nkọwa dị nkọ karị n\'oge mmegharị ahụ mana na-ebute faịlụ vidiyo buru ibu.</string>
    <string name="guide_bitrate_mode_desc">VBR (Bitrate mgbanwe) na-agbakọ ọnụego data n\'ike n\'ike iji chekwaa nchekwa. CBR (Constant Bitrate) na-amanye nkọwa dị elu n\'agbanyeghị mmegharị ahụ.</string>
    <string name="guide_audio_source_desc">Họrọ site na Silence (gbanyụọ), Igwe okwu (MIC), Sistemụ Internal Loopback (SYS), ma ọ bụ MIX (SYS+MIC) ka ịdekọ ha abụọ ọnụ.</string>
    <string name="guide_audio_quality_desc">Gbanwee ọnụego nlele ọdịyo na itinye koodu bitrate. Ọkwa dị elu na-enye nkọwa ụda dị ọcha, enweghị mkpọtụ.</string>
    <string name="dialog_auto_orientation_title">⚠ Ịdọ aka ná ntị nghazi akpaaka</string>
    <string name="dialog_auto_orientation_message">Auto Orientation bụ gimmick ga-eweda ogo ndekọ gị.\n\nAndroid na-atụgharị n\'ike n\'ike n\'ihe ngosi nke ọma n\'etiti ndekọ, na-ebutekarị ndakọrịta mkpebi, ogwe ojii, na enweghị nkwudo okwu.</string>
    <string name="dialog_auto_orientation_button_timer">Aghọtara m (%d)</string>
    <string name="dialog_auto_orientation_button">Aghọtara m</string>
    <string name="dialog_overlay_permission_title">Achọrọ ikike machie</string>
    <string name="dialog_overlay_permission_message">Iji gosi afụ njikwa na-ese n\'elu mmiri, RecorderX chọrọ ikike igosipụta n\'elu ngwa ndị ọzọ. Biko nye ya na ihuenyo na-esote.</string>
