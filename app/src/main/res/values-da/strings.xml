    <!-- Auto-generated translations for all UI & guides -->
    <string name="title_swipe_here">SWIPE HER</string>
    <string name="title_recorder">OPTAGERE</string>
    <string name="saved_in_path">Gemt i: /Movies/RecorderX</string>
    <string name="guide_codec_desc">H.264 (mest kompatibel med andre afspillere), H.265 (højeffektiv komprimering) eller AV1 (Næste generations høj kvalitet).</string>
    <string name="guide_orientation_desc">Lås optaget videoformatforhold til Auto, Portræt (lodret) eller Landskab (vandret).</string>
    <string name="guide_resolution_desc">NATIVE optager med din skærms nøjagtige opløsning. 4K-, 2K-, FHD-, HD- og SD-låsefanger til standardmål.</string>
    <string name="guide_fps_desc">Rækkevidde på 24-60 FPS for standard videoglathed. Enheder med høj opdateringshastighed understøtter 90-120 FPS for ultra-glat spilafspilning.</string>
    <string name="guide_bitrate_desc">Angiver datahastighed i Mbps. Højere værdier fanger skarpere detaljer under bevægelse, men resulterer i større videofiler.</string>
    <string name="guide_bitrate_mode_desc">VBR (Variable Bitrate) skalerer datahastigheden dynamisk for at spare lagerplads. CBR (Constant Bitrate) fremtvinger høje detaljer uanset bevægelse.</string>
    <string name="guide_audio_source_desc">Vælg mellem Silence (OFF), Mikrofon (MIC), System Internal Loopback (SYS) eller MIX (SYS+MIC) for at optage begge sammen.</string>
    <string name="guide_audio_quality_desc">Juster lydsamplingshastighed og kodningsbithastighed. Højere niveauer giver renere, støjfri lyddetaljer.</string>
    <string name="dialog_auto_orientation_title">⚠ Advarsel om automatisk orientering</string>
    <string name="dialog_auto_orientation_message">Automatisk orientering er en gimmick og vil forringe din optagekvalitet.\n\nAndroid roterer dynamisk den virtuelle skærm midt i optagelsen, hvilket ofte forårsager opløsningsfejl, sorte bjælker og encoderinstabilitet.\n\nVi anbefaler på det kraftigste, at du manuelt vælger Portræt eller Landskab for at matche den primære orientering af den app, du har tænkt dig at optage bedst, hvilket giver mest ensartet output.</string>
    <string name="dialog_auto_orientation_button_timer">Jeg forstår (%d)</string>
    <string name="dialog_auto_orientation_button">Jeg forstår</string>
    <string name="dialog_overlay_permission_title">Overlay-tilladelse påkrævet</string>
    <string name="dialog_overlay_permission_message">For at vise den flydende controller-boble skal RecorderX have tilladelse til at blive vist over andre apps. Giv det venligst på næste skærmbillede.</string>
    <string name="btn_grant">Giv tilladelse</string>
    <string name="btn_cancel">Annuller</string>
    <string name="dialog_av1_software_title">⚠ AV1 Software Encoding</string>
    <string name="dialog_av1_software_message">Hardware AV1-kodning er ikke understøttet på denne enhed.\n\nOptagelsen vil blive udført ved hjælp af Software AV1 (CPU-kodning). Dette kan forårsage øget CPU-brug, højere batteriforbrug og potentielle billedfald ved højere opløsninger.</string>
    <string name="dialog_av1_software_button">JEG FORSTÅR</string>
