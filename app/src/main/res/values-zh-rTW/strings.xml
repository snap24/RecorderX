    <!-- Auto-generated translations for all UI & guides -->
    <string name="title_swipe_here">在這裡滑動</string>
    <string name="title_recorder">錄音機</string>
    <string name="saved_in_path">儲存於：/Movies/RecorderX</string>
    <string name="guide_codec_desc">H.264（與其他播放器最相容）、H.265（高效壓縮）或 AV1（下一代高品質）。</string>
    <string name="guide_orientation_desc">將錄製的影片寬高比鎖定為自動、縱向（垂直）或橫向（水平）。</string>
    <string name="guide_resolution_desc">NATIVE 以螢幕的精確解析度擷取。 4K、2K、FHD、HD 和 SD 將擷取鎖定為標準尺寸。</string>
    <string name="guide_fps_desc">標準影片流暢度範圍為 24-60 FPS。高更新率設備支援 90-120 FPS，實現超流暢的遊戲播放。</string>
    <string name="guide_bitrate_desc">指定資料速度（以 Mbps 為單位）。較高的值在運動過程中捕捉到更清晰的細節，但會導致視訊檔案更大。</string>
    <string name="guide_bitrate_mode_desc">VBR（可變位元速率）動態調整資料速率以節省儲存空間。無論運動如何，CBR（恆定位元率）都會強制提供高細節。</string>
    <string name="guide_audio_source_desc">選擇靜音 (OFF)、麥克風 (MIC)、系統內部環回 (SYS) 或混合 (SYS+MIC) 將兩者一起錄製。</string>
    <string name="guide_audio_quality_desc">調整音訊取樣率和編碼位元率。更高的層可提供更乾淨、無雜訊的聲音細節。</string>
    <string name="dialog_auto_orientation_title">⚠ 自動方向警告</string>
    <string name="dialog_auto_orientation_message">自動方向是一個噱頭，會降低您的錄製品質。 \n\nAndroid 在錄製過程中動態旋轉虛擬顯示器，通常會導致解析度不匹配、黑條和編碼器不穩定。 \n\n我們強烈建議手動選擇縱向或橫向以符合您要錄製的應用程式的主要方向 - 這會產生最佳、最一致的輸出。</string>
    <string name="dialog_auto_orientation_button_timer">我明白了 (%d)</string>
    <string name="dialog_auto_orientation_button">我明白</string>
    <string name="dialog_overlay_permission_title">需要疊加權限</string>
    <string name="dialog_overlay_permission_message">若要顯示浮動控制器氣泡，RecorderX 需要在其他應用程式上顯示的權限。請在下一個畫面上授予它。</string>
    <string name="btn_grant">格蘭特</string>
    <string name="btn_cancel">取消</string>
    <string name="dialog_av1_software_title">⚠ AV1 軟體編碼</string>
    <string name="dialog_av1_software_message">此設備不支援硬體 AV1 編碼。 \n\n將使用軟體 AV1（CPU 編碼）進行錄製。這可能會導致 CPU 使用率增加、電池消耗增加以及在高解析度下可能出現幀丟失。</string>
    <string name="dialog_av1_software_button">我明白</string>
    <string name="dialog_language_title">選擇語言 (80)</string>
    <string name="search_language_hint">搜尋語言...</string>
    <string name="lang_system_default">系統預設值</string>
    <string name="naming_template_helper">在範本框中鍵入您的首選前綴，以個性化您儲存的影片標題。 \n新增 {timestamp} 佔位符，以確保每個檔案都按日期順序組織。 \n無效字元將自動刪除，如果為空，則預設為乾淨的時間戳記。 \n格式：yyyyMMdd_HHmmss（例如 20260712_143000）。</string>
    <string name="onboarding_swipe_title">🎨 滑動即可重新著色</string>
