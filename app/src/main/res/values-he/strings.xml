    <string name="title_swipe_here">SWIPE כאן</string>
    <string name="title_recorder">מקליט</string>
    <string name="saved_in_path">נשמר ב: /Movies/RecorderX</string>
    <string name="guide_codec_desc">H.264 (התואם ביותר לנגנים אחרים), H.265 (דחיסה יעילה ביותר), או AV1 (איכות גבוהה מהדור הבא).</string>
    <string name="guide_orientation_desc">נעל את יחסי הגובה-רוחב של וידאו מוקלט לאוטומטי, דיוקן (אנכי) או לרוחב (אופקי).</string>
    <string name="guide_resolution_desc">NATIVE מצלם ברזולוציה המדויקת של המסך שלך. לכידת נעילת 4K, 2K, FHD, HD ו-SD למידות סטנדרטיות.</string>
    <string name="guide_fps_desc">טווח של 24-60 FPS עבור חלקות וידאו סטנדרטית. התקני קצב רענון גבוה תומכים ב-90-120 FPS להפעלת משחקים חלקה במיוחד.</string>
    <string name="guide_bitrate_desc">מציין את מהירות הנתונים ב-Mbps. ערכים גבוהים יותר לוכדים פרטים חדים יותר במהלך תנועה אך מביאים לקבצי וידאו גדולים יותר.</string>
    <string name="guide_bitrate_mode_desc">VBR (קצב סיביות משתנה) משנה באופן דינמי את קצב הנתונים כדי לחסוך באחסון. CBR (Constant Bitrate) מאלץ פרטים גבוהים ללא קשר לתנועה.</string>
    <string name="guide_audio_source_desc">בחר מתוך שתיקה (כבוי), מיקרופון (MIC), מערכת לולאה פנימית (SYS), או MIX (SYS+MIC) כדי להקליט את שניהם יחד.</string>
    <string name="guide_audio_quality_desc">התאם את קצב דגימת השמע ואת קצב הקידוד. שכבות גבוהות יותר מספקות פרטי צליל נקיים יותר וללא רעשים.</string>
    <string name="dialog_auto_orientation_title">⚠ אזהרת כיוון אוטומטי</string>
    <string name="dialog_auto_orientation_message">התמצאות אוטומטית היא גימיק ויפגע באיכות ההקלטה שלך.\n\nאנדרואיד מסובב באופן דינמי את התצוגה הוירטואלית באמצע ההקלטה, ולעיתים גורם לאי-התאמה ברזולוציה, פסים שחורים וחוסר יציבות של המקודד.\n\nאנו ממליצים בחום לבחור ידנית לאורך או לרוחב כדי להתאים לכיוון הראשי של האפליקציה שאתה מתכוון להקליט בצורה הטובה ביותר - זה מייצר את הפלט העקבי ביותר.</string>
    <string name="dialog_auto_orientation_button_timer">אני מבין (%d)</string>
    <string name="dialog_auto_orientation_button">אני מבין</string>
    <string name="dialog_overlay_permission_title">נדרשת הרשאת שכבת-על</string>
    <string name="dialog_overlay_permission_message">כדי להציג את בועת הבקר הצפה, RecorderX זקוק להרשאה להציג מעל אפליקציות אחרות. אנא הענק זאת במסך הבא.</string>
    <string name="btn_grant">גרנט</string>
    <string name="btn_cancel">בטל</string>
    <string name="dialog_av1_software_title">⚠ קידוד תוכנה AV1</string>
    <string name="dialog_av1_software_message">קידוד AV1 של חומרה אינו נתמך במכשיר זה.\n\nההקלטה תתבצע באמצעות תוכנת AV1 (קידוד מעבד). זה עלול לגרום לשימוש מוגבר ב-CPU, לצריכת סוללה גבוהה יותר ולירידה אפשרית בפריים ברזולוציות גבוהות יותר.</string>
