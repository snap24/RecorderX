    <string name="title_swipe_here">Pyyhkäise TÄSTÄ</string>
    <string name="title_recorder">TALLENNIN</string>
    <string name="saved_in_path">Tallennettu kansioon: /Movies/RecorderX</string>
    <string name="guide_codec_desc">H.264 (yhteensopivin muiden soittimien kanssa), H.265 (erittäin tehokas pakkaus) tai AV1 (seuraavan sukupolven korkea laatu).</string>
    <string name="guide_orientation_desc">Lukitse tallennetun videon kuvasuhteet tilaan Auto, Portrait (pysty) tai Landscape (vaaka).</string>
    <string name="guide_resolution_desc">NATIVE tallentaa näytön tarkalla resoluutiolla. 4K-, 2K-, FHD-, HD- ja SD-lukituskaappaus vakiomittoihin.</string>
    <string name="guide_fps_desc">Alue 24-60 FPS normaaliin videon tasaisuuteen. Korkean virkistystaajuuden laitteet tukevat 90-120 FPS:n taajuutta erittäin sulavaan pelitoistoon.</string>
    <string name="guide_bitrate_desc">Määrittää tiedonsiirtonopeuden Mbps. Suuremmat arvot tallentavat terävämpiä yksityiskohtia liikkeen aikana, mutta johtavat suurempiin videotiedostoihin.</string>
    <string name="guide_bitrate_mode_desc">VBR (Variable Bitrate) skaalaa dynaamisesti tiedonsiirtonopeuden säästääkseen tallennustilaa. CBR (Constant Bitrate) pakottaa korkeat yksityiskohdat liikkeestä riippumatta.</string>
    <string name="guide_audio_source_desc">Valitse Hiljaisuus (OFF), Mikrofoni (MIC), System Internal Loopback (SYS) tai MIX (SYS+MIC) tallentaaksesi molemmat yhdessä.</string>
    <string name="guide_audio_quality_desc">Säädä äänen näytetaajuutta ja koodauksen bittinopeutta. Korkeammat tasot tarjoavat puhtaampia, meluttomia ääniyksityiskohtia.</string>
    <string name="dialog_auto_orientation_title">⚠ Automaattisen suuntauksen varoitus</string>
    <string name="dialog_auto_orientation_message">Automaattinen suuntaus on temppu ja heikentää tallennuslaatua.\n\nAndroid pyörittää virtuaalista näyttöä dynaamisesti kesken tallennuksen, mikä aiheuttaa usein erottelutarkkuutta, mustia palkkeja ja enkooderin epävakautta.\n\nSuosittelemme, että valitset manuaalisesti Pysty- tai Vaaka-asetuksen, jotta se vastaa tallennettavan sovelluksen ensisijaista suuntaa – tämä tuottaa parhaan tuloksen.</string>
    <string name="dialog_auto_orientation_button_timer">Ymmärrän (%d)</string>
    <string name="dialog_auto_orientation_button">Ymmärrän</string>
    <string name="dialog_overlay_permission_title">Peittokuvan lupa vaaditaan</string>
    <string name="dialog_overlay_permission_message">Kelluvan ohjainkuplan näyttämiseksi RecorderX tarvitsee luvan näyttää muiden sovellusten päällä. Myönnä se seuraavassa näytössä.</string>
    <string name="btn_grant">Myönnä</string>
    <string name="btn_cancel">Peruuta</string>
    <string name="dialog_av1_software_title">⚠ AV1-ohjelmistokoodaus</string>
    <string name="dialog_av1_software_message">Tämä laite ei tue laitteiston AV1-koodausta.\n\nTallennus suoritetaan Software AV1:llä (CPU-koodaus). Tämä voi aiheuttaa lisääntynyttä prosessorin käyttöä, korkeampaa akun kulutusta ja mahdollista kehysten putoamista korkeammilla resoluutioilla.</string>
    <string name="dialog_av1_software_button">YMMÄRRÄN</string>
    <string name="dialog_language_title">VALITSE KIELI (80)</string>
    <string name="search_language_hint">Hakukieli…</string>
    <string name="lang_system_default">Järjestelmän oletusarvo</string>
    <string name="naming_template_helper">Kirjoita haluamasi etuliite mallikenttään muokataksesi tallennettuja videoiden nimiä.\nLisää {timestamp}-paikkamerkki varmistaaksesi, että kaikki tiedostot järjestetään järjestyksessä päivämäärän mukaan.\nVirheelliset merkit poistetaan automaattisesti, oletuksena on puhdas aikaleima, jos se on tyhjä.\nMuoto: yyyyMMdd_HHmmss.0_2 (e.4)</string>
