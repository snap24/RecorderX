    <!-- Guide Dialog Descriptions -->
    <string name="guide_codec_desc">H.264 (Most compatible with other players), H.265 (Highly efficient compression), or AV1 (Next-generation high quality).</string>
    <string name="guide_orientation_desc">Lock recorded video aspect ratios to Auto, Portrait (vertical), or Landscape (horizontal).</string>
    <string name="guide_resolution_desc">NATIVE captures at your screen\'s exact resolution. 4K, 2K, FHD, HD, and SD lock capture to standard dimensions.</string>
    <string name="guide_fps_desc">Range of 24-60 FPS for standard video smoothness. High refresh rate devices support 90-120 FPS for ultra-smooth gaming playback.</string>
    <string name="guide_bitrate_desc">Specifies data speed in Mbps. Higher values capture sharper details during movement but result in larger video files.</string>
    <string name="guide_bitrate_mode_desc">VBR (Variable Bitrate) dynamically scales data rate to save storage. CBR (Constant Bitrate) forces high details regardless of movement.</string>
    <string name="guide_audio_source_desc">Choose from Silence (OFF), Microphone (MIC), System Internal Loopback (SYS), or MIX (SYS+MIC) to record both together.</string>
    <string name="guide_audio_quality_desc">Adjust audio sample rate and encoding bitrate. Higher tiers provide cleaner, noise-free sound details.</string>

    <!-- Auto Orientation Warning Dialog -->
    <string name="dialog_auto_orientation_title">⚠  Auto Orientation Warning</string>
    <string name="dialog_auto_orientation_message">Auto Orientation is a gimmick and will degrade your recording quality.\n\nAndroid dynamically rotates the virtual display mid-recording, often causing resolution mismatches, black bars, and encoder instability.\n\nWe strongly recommend manually selecting Portrait or Landscape to match the primary orientation of the app you intend to record — this produces the best, most consistent output.</string>
    <string name="dialog_auto_orientation_button_timer">I Understand (%d)</string>
    <string name="dialog_auto_orientation_button">I Understand</string>

    <!-- Overlay Permission Dialog -->
    <string name="dialog_overlay_permission_title">Overlay Permission Required</string>
    <string name="dialog_overlay_permission_message">To display the floating controller bubble, RecorderX needs permission to display over other apps. Please grant it on the next screen.</string>
    <string name="btn_grant">Grant</string>
    <string name="btn_cancel">Cancel</string>

    <!-- AV1 Software Warning Dialog -->
    <string name="dialog_av1_software_title">⚠  AV1 Software Encoding</string>
    <string name="dialog_av1_software_message">Hardware AV1 encoding is not supported on this device.\n\nRecording will be performed using Software AV1 (CPU encoding). This may cause increased CPU usage, higher battery consumption, and potential frame drops on higher resolutions.</string>
    <string name="dialog_av1_software_button">I UNDERSTAND</string>

