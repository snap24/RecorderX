    <!-- Auto-generated translations for all UI & guides -->
    <string name="title_swipe_here">여기를 스와이프하세요</string>
    <string name="title_recorder">레코더</string>
    <string name="saved_in_path">저장 위치: /Movies/RecorderX</string>
    <string name="guide_codec_desc">H.264(다른 플레이어와 가장 잘 호환됨), H.265(고효율 압축) 또는 AV1(차세대 고품질).</string>
    <string name="guide_orientation_desc">녹화된 비디오 화면비를 자동, 세로(세로) 또는 가로(가로)로 고정합니다.</string>
    <string name="guide_resolution_desc">NATIVE는 화면의 정확한 해상도로 캡처합니다. 4K, 2K, FHD, HD 및 SD 잠금 캡처를 표준 크기로 캡처합니다.</string>
    <string name="guide_fps_desc">표준 비디오 부드러움을 위한 24-60FPS 범위. 높은 화면 주사율 장치는 매우 부드러운 게임 재생을 위해 90-120FPS를 지원합니다.</string>
    <string name="guide_bitrate_desc">데이터 속도를 Mbps 단위로 지정합니다. 값이 높을수록 이동 중에 더 선명한 세부 정보가 캡처되지만 비디오 파일 크기가 커집니다.</string>
    <string name="guide_bitrate_mode_desc">VBR(가변 비트 전송률)은 데이터 속도를 동적으로 확장하여 스토리지를 절약합니다. CBR(Constant Bitrate)은 움직임에 관계없이 높은 디테일을 구현합니다.</string>
    <string name="guide_audio_source_desc">무음(OFF), 마이크(MIC), 시스템 내부 루프백(SYS) 또는 MIX(SYS+MIC) 중에서 선택하여 두 가지를 함께 녹음합니다.</string>
    <string name="guide_audio_quality_desc">오디오 샘플 속도와 인코딩 비트 전송률을 조정합니다. 계층이 높을수록 더 깨끗하고 잡음 없는 사운드 디테일을 제공합니다.</string>
    <string name="dialog_auto_orientation_title">⚠ 자동 방향 경고</string>
    <string name="dialog_auto_orientation_message">자동 방향은 속임수이며 녹화 품질을 저하시킵니다.\n\nAndroid는 녹화 중에 가상 디스플레이를 동적으로 회전하여 종종 해상도 불일치, 검은색 막대 및 인코더 불안정성을 유발합니다.\n\n녹화하려는 앱의 기본 방향과 일치하도록 세로 또는 가로를 수동으로 선택하는 것이 좋습니다. 이렇게 하면 가장 일관된 최상의 출력이 생성됩니다.</string>
    <string name="dialog_auto_orientation_button_timer">이해합니다 (%d)</string>
    <string name="dialog_auto_orientation_button">나는 이해한다</string>
    <string name="dialog_overlay_permission_title">오버레이 권한이 필요합니다</string>
    <string name="dialog_overlay_permission_message">플로팅 컨트롤러 버블을 표시하려면 RecorderX에 다른 앱 위에 표시할 수 있는 권한이 필요합니다. 다음 화면에서 승인해 주세요.</string>
    <string name="btn_grant">그랜트</string>
    <string name="btn_cancel">취소</string>
    <string name="dialog_av1_software_title">⚠ AV1 소프트웨어 인코딩</string>
    <string name="dialog_av1_software_message">이 장치에서는 하드웨어 AV1 인코딩이 지원되지 않습니다.\n\n녹화는 소프트웨어 AV1(CPU 인코딩)을 사용하여 수행됩니다. 이로 인해 CPU 사용량이 증가하고 배터리 소모가 증가하며 더 높은 해상도에서 잠재적인 프레임 저하가 발생할 수 있습니다.</string>
    <string name="dialog_av1_software_button">나는 이해한다</string>
