    <string name="title_swipe_here">SWIPU ZDE</string>
    <string name="title_recorder">ZÁZNAMNÍK</string>
    <string name="saved_in_path">Uloženo v: /Movies/RecorderX</string>
    <string name="guide_codec_desc">H.264 (nejvíce kompatibilní s jinými přehrávači), H.265 (vysoce účinná komprese) nebo AV1 (vysoká kvalita nové generace).</string>
    <string name="guide_orientation_desc">Uzamkněte poměr stran zaznamenaného videa na Auto, Portrét (vertikální) nebo Landscape (horizontální).</string>
    <string name="guide_resolution_desc">NATIVE snímá v přesném rozlišení vaší obrazovky. 4K, 2K, FHD, HD a SD zachycení zámku na standardní rozměry.</string>
    <string name="guide_fps_desc">Rozsah 24-60 FPS pro standardní plynulost videa. Zařízení s vysokou obnovovací frekvencí podporují 90-120 FPS pro ultra plynulé přehrávání her.</string>
    <string name="guide_bitrate_desc">Určuje rychlost přenosu dat v Mbps. Vyšší hodnoty zachycují ostřejší detaily během pohybu, ale výsledkem jsou větší soubory videa.</string>
    <string name="guide_bitrate_mode_desc">VBR (Variable Bitrate) dynamicky škáluje datovou rychlost, aby se ušetřilo úložiště. CBR (Constant Bitrate) vynucuje vysoké detaily bez ohledu na pohyb.</string>
    <string name="guide_audio_source_desc">Vyberte si z možností Ticho (OFF), Mikrofon (MIC), System Internal Loopback (SYS) nebo MIX (SYS+MIC) pro záznam obojího dohromady.</string>
    <string name="guide_audio_quality_desc">Upravte vzorkovací frekvenci zvuku a bitovou rychlost kódování. Vyšší úrovně poskytují čistší detaily zvuku bez šumu.</string>
    <string name="dialog_auto_orientation_title">⚠ Upozornění na automatickou orientaci</string>
    <string name="dialog_auto_orientation_message">Automatická orientace je trik, který sníží kvalitu vašeho záznamu.\n\nAndroid dynamicky otáčí virtuální displej uprostřed záznamu, což často způsobuje nesoulad v rozlišení, černé pruhy a nestabilitu kodéru.\n\nDůrazně doporučujeme ručně vybrat Na výšku nebo Na šířku, aby odpovídaly primární orientaci aplikace, kterou chcete nahrávat – výsledkem je nejlepší a nejkonzistentnější výstup.</string>
    <string name="dialog_auto_orientation_button_timer">Rozumím (%d)</string>
    <string name="dialog_auto_orientation_button">Rozumím</string>
    <string name="dialog_overlay_permission_title">Je vyžadováno oprávnění k překrytí</string>
    <string name="dialog_overlay_permission_message">K zobrazení plovoucí bubliny ovladače potřebuje RecorderX oprávnění k zobrazení přes jiné aplikace. Udělte to prosím na další obrazovce.</string>
    <string name="btn_grant">Povolit</string>
    <string name="btn_cancel">Zrušit</string>
    <string name="dialog_av1_software_title">⚠ Softwarové kódování AV1</string>
    <string name="dialog_av1_software_message">Hardwarové kódování AV1 není na tomto zařízení podporováno.\n\nNahrávání bude provedeno pomocí softwaru AV1 (kódování CPU). To může způsobit zvýšené využití procesoru, vyšší spotřebu baterie a potenciální pokles snímků při vyšším rozlišení.</string>
    <string name="dialog_av1_software_button">ROZUMÍM</string>
    <string name="dialog_language_title">ZVOLTE JAZYK (80)</string>
