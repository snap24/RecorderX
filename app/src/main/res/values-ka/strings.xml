    <string name="guide_codec_desc">H.264 (ყველაზე თავსებადი სხვა მოთამაშეებთან), H.265 (უაღრესად ეფექტური შეკუმშვა) ან AV1 (შემდეგი თაობის მაღალი ხარისხი).</string>
    <string name="guide_orientation_desc">ჩაკეტეთ ჩაწერილი ვიდეო ასპექტის კოეფიციენტები ავტო, პორტრეტი (ვერტიკალური) ან ლანდშაფტი (ჰორიზონტალური).</string>
    <string name="guide_resolution_desc">NATIVE იღებს თქვენი ეკრანის ზუსტი გარჩევადობით. 4K, 2K, FHD, HD და SD lock გადაღება სტანდარტულ ზომებზე.</string>
    <string name="guide_fps_desc">დიაპაზონი 24-60 FPS ვიდეოს სტანდარტული სიგლუვისთვის. განახლების მაღალი სიჩქარის მოწყობილობები მხარს უჭერენ 90-120 FPS ულტრა გლუვი თამაშების დაკვრისთვის.</string>
    <string name="guide_bitrate_desc">განსაზღვრავს მონაცემთა სიჩქარეს Mbps-ში. უფრო მაღალი მნიშვნელობები იჭერს უფრო მკვეთრ დეტალებს მოძრაობის დროს, მაგრამ იწვევს უფრო დიდ ვიდეო ფაილებს.</string>
    <string name="guide_bitrate_mode_desc">VBR (ცვლადი ბიტის სიხშირე) დინამიურად ამცირებს მონაცემთა სიჩქარეს მეხსიერების დაზოგვის მიზნით. CBR (მუდმივი ბიტრეიტი) აიძულებს მაღალ დეტალებს მოძრაობის მიუხედავად.</string>
    <string name="guide_audio_source_desc">ორივე ერთად ჩასაწერად აირჩიეთ სიჩუმე (გამორთული), მიკროფონი (MIC), სისტემის შიდა მარყუჟი (SYS) ან MIX (SYS+MIC).</string>
    <string name="guide_audio_quality_desc">დაარეგულირეთ აუდიო ნიმუშის სიხშირე და კოდირების ბიტრეიტი. უმაღლესი დონეები უზრუნველყოფს უფრო სუფთა, ხმაურის გარეშე ხმის დეტალებს.</string>
    <string name="dialog_auto_orientation_title">⚠ ავტომატური ორიენტაციის გაფრთხილება</string>
    <string name="dialog_auto_orientation_message">ავტომატური ორიენტაცია ხრიკია და დააქვეითებს ჩაწერის ხარისხს.\n\nAndroid დინამიურად აბრუნებს ვირტუალურ ეკრანს ჩაწერის შუა რიცხვებში, რაც ხშირად იწვევს გარჩევადობის შეუსაბამობას, შავ ზოლებს და ენკოდერის არასტაბილურობას.\n\nჩვენ გირჩევთ ხელით აირჩიოთ პორტრეტი ან პეიზაჟი, რათა შეესაბამებოდეს პირველადი ორიენტაციას - ეს აპი საუკეთესოდ აწარმოებს.</string>
