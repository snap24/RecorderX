    <!-- Auto-generated translations for all UI & guides -->
    <string name="title_swipe_here">HALKAN KU DHACO</string>
    <string name="title_recorder">duubitaan</string>
    <string name="saved_in_path">Lagu kaydiyay: /Filimooyin/RecorderX</string>
    <string name="guide_codec_desc">H.264 (Inta badan la jaan qaadaya ciyaartoyda kale), H.265 (cadaadis aad u hufan), ama AV1 (jiilka soo socda tayo sare leh).</string>
    <string name="guide_orientation_desc">Quful dhinaca saamiga muuqaalka duuban ee Auto, Portrait (toos ah), ama muuqaal muuqaal (horizontal).</string>
    <string name="guide_resolution_desc">HALKAAN HOOSE waxay ku sawirtaa xalka saxda ah ee shaashaddaada. 4K, 2K, FHD, HD, iyo qabashada qufulka SD ilaa cabbirada caadiga ah.</string>
    <string name="guide_fps_desc">Qiyaasta 24-60 FPS ee siman fiidyaha caadiga ah. Aaladaha heerka cusboonaysiinta sare waxay taageerayaan 90-120 FPS dib-u-ciyaarista ciyaaraha aadka u jilicsan.</string>
    <string name="guide_bitrate_desc">Waxay ku qeexdaa xawaaraha xogta ee Mbps. Qiimayaasha sare waxay qabtaan tafaasiisha fiiqan inta lagu jiro dhaqdhaqaaqa laakiin waxay keenaan faylal fiidyow oo waaweyn.</string>
    <string name="guide_bitrate_mode_desc">VBR (Variable Bitrate) waxay si firfircoon u miisaamaysaa heerka xogta si loo badbaadiyo kaydinta. CBR (Constant Bitrate) waxay xooga saartaa tafaasiisha sare iyadoon loo eegin dhaqdhaqaaqa.</string>
    <string name="guide_audio_source_desc">Ka dooro aamusnaanta (OFF), makarafoon (MIC), System Internal Loopback (SYS), ama MIX (SYS+MIC) si aad u duubto labadaba.</string>
    <string name="guide_audio_quality_desc">Hagaaji heerka muunada codka iyo codaynta bitrate-ka. Heerarka sare waxay bixiyaan tafaasiisha dhawaaq ka nadiifsan, aan buuq lahayn.</string>
