    <string name="title_swipe_here">PAVELK ŠEIT</string>
    <string name="title_recorder">RAKSTĪTĀJS</string>
    <string name="saved_in_path">Saglabāts: /Movies/RecorderX</string>
    <string name="guide_codec_desc">H.264 (visvairāk saderīgs ar citiem atskaņotājiem), H.265 (ļoti efektīva saspiešana) vai AV1 (nākamās paaudzes augsta kvalitāte).</string>
    <string name="guide_orientation_desc">Bloķējiet ierakstītā video malu attiecības uz automātisku, portretu (vertikāli) vai ainavu (horizontāli).</string>
    <string name="guide_resolution_desc">NATIVE tver ar precīzu jūsu ekrāna izšķirtspēju. 4K, 2K, FHD, HD un SD fiksēšana standarta izmēros.</string>
    <string name="guide_fps_desc">Diapazons no 24 līdz 60 kadri sekundē standarta video vienmērīgam attēlam. Ierīces ar augstu atsvaidzes intensitāti atbalsta 90–120 kadrus sekundē īpaši vienmērīgai spēļu atskaņošanai.</string>
    <string name="guide_bitrate_desc">Norāda datu ātrumu Mbps. Augstākas vērtības kustības laikā uztver asākas detaļas, bet rada lielākus video failus.</string>
    <string name="guide_bitrate_mode_desc">VBR (mainīgais bitu pārraides ātrums) dinamiski mērogo datu pārraides ātrumu, lai ietaupītu krātuvi. CBR (Constant Bitrate) nodrošina augstas detaļas neatkarīgi no kustības.</string>
    <string name="guide_audio_source_desc">Izvēlieties no Klusums (IZSLĒGTS), Mikrofons (MIC), Sistēmas iekšējā cilpa (SYS) vai MIX (SYS+MIC), lai ierakstītu abus kopā.</string>
    <string name="guide_audio_quality_desc">Pielāgojiet audio izlases ātrumu un kodēšanas bitu pārraides ātrumu. Augstāki līmeņi nodrošina tīrākas skaņas detaļas bez trokšņa.</string>
    <string name="dialog_auto_orientation_title">⚠ Automātiskās orientācijas brīdinājums</string>
    <string name="dialog_auto_orientation_message">Automātiskā orientācija ir triks, kas pasliktinās ierakstīšanas kvalitāti.\n\nAndroid dinamiski rotē virtuālo displeju ierakstīšanas laikā, bieži izraisot izšķirtspējas neatbilstības, melnas joslas un kodētāja nestabilitāti.\n\nIeteicam manuāli atlasīt portretu vai ainavu, lai tas atbilstu tās lietotnes primārajai orientācijai, kuru plānojat ierakstīt — tas nodrošina vislabāko izvadi.</string>
    <string name="dialog_auto_orientation_button_timer">Es saprotu (%d)</string>
    <string name="dialog_auto_orientation_button">Es saprotu</string>
    <string name="dialog_overlay_permission_title">Nepieciešama pārklājuma atļauja</string>
    <string name="dialog_overlay_permission_message">Lai parādītu peldošo kontrollera burbuli, programmai RecorderX ir nepieciešama rādīšanas atļauja pār citām lietotnēm. Lūdzu, piešķiriet to nākamajā ekrānā.</string>
    <string name="btn_grant">Piešķirt</string>
    <string name="btn_cancel">Atcelt</string>
    <string name="dialog_av1_software_title">⚠ AV1 programmatūras kodējums</string>
    <string name="dialog_av1_software_message">Aparatūras AV1 kodējums šajā ierīcē netiek atbalstīts.\n\nIeraksts tiks veikts, izmantojot Software AV1 (CPU kodējums). Tas var izraisīt palielinātu CPU lietojumu, lielāku akumulatora patēriņu un iespējamu kadru kritumu augstākas izšķirtspējas gadījumā.</string>
    <string name="dialog_av1_software_button">ES SAPROTU</string>
