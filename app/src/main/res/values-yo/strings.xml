    <string name="guide_codec_desc">H.264 (Ọpọlọpọ ni ibamu pẹlu awọn ẹrọ orin miiran), H.265 (Imudara ti o ga julọ), tabi AV1 (ti o ga julọ ti iran-tẹle).</string>
    <string name="guide_orientation_desc">Titiipa awọn ipin abala fidio ti o gbasilẹ si Aifọwọyi, Aworan (inaro), tabi Ilẹ-ilẹ (petele).</string>
    <string name="guide_resolution_desc">NTIVE yaworan ni oju iboju rẹ gangan ipinnu. 4K, 2K, FHD, HD, ati gbigba titiipa SD si awọn iwọn boṣewa.</string>
    <string name="guide_fps_desc">Iwọn ti 24-60 FPS fun didan fidio boṣewa. Awọn ẹrọ oṣuwọn isọdọtun giga ṣe atilẹyin 90-120 FPS fun ṣiṣiṣẹsẹhin ere didan.</string>
    <string name="guide_bitrate_desc">Ntọka iyara data ni Mbps. Awọn iye ti o ga julọ gba awọn alaye didan lakoko gbigbe ṣugbọn ja si awọn faili fidio ti o tobi julọ.</string>
    <string name="guide_bitrate_mode_desc">VBR (Odiwọn Bitrate Ayipada) ṣe iwọn iwọn data ni agbara lati ṣafipamọ ibi ipamọ. CBR (Constant Bitrate) fi agbara mu awọn alaye giga laibikita gbigbe.</string>
    <string name="guide_audio_source_desc">Yan lati ipalọlọ (PA), Gbohungbohun (MIC), Loopback Internal System (SYS), tabi MIX (SYS+MIC) lati ṣe igbasilẹ mejeeji papọ.</string>
    <string name="guide_audio_quality_desc">Ṣatunṣe oṣuwọn ayẹwo ohun ati fifi koodu bitrate. Awọn ipele ti o ga julọ pese mimọ, awọn alaye ohun ti ko ni ariwo.</string>
    <string name="dialog_auto_orientation_title">⚠ Ikilọ Iṣalaye Aifọwọyi</string>
    <string name="dialog_auto_orientation_message">Iṣalaye Aifọwọyi jẹ gimmick ati pe yoo dinku didara gbigbasilẹ rẹ.\n\nAndroid ni agbara n yi ifihan foju han ni agbedemeji gbigbasilẹ, nigbagbogbo nfa awọn aiṣedeede ipinnu, awọn ifi dudu, ati aisedeede koodu.</string>
    <string name="dialog_auto_orientation_button_timer">Mo Loye (%d)</string>
    <string name="dialog_auto_orientation_button">O ye mi</string>
    <string name="dialog_overlay_permission_title">Ti beere fun igbanilaaye agbekọja</string>
    <string name="dialog_overlay_permission_message">Lati ṣafihan bubble oludari lilefoofo, RecorderX nilo igbanilaaye lati ṣafihan lori awọn ohun elo miiran. Jọwọ fun ni loju iboju atẹle.</string>
