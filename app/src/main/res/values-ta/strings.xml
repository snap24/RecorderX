    <!-- Auto-generated translations for all UI & guides -->
    <string name="title_swipe_here">இங்கே ஸ்வைப் செய்யவும்</string>
    <string name="title_recorder">ரெக்கார்டர்</string>
    <string name="saved_in_path">இதில் சேமிக்கப்பட்டது: /Movies/RecorderX</string>
    <string name="guide_codec_desc">H.264 (பிற வீரர்களுடன் மிகவும் இணக்கமானது), H.265 (அதிக திறமையான சுருக்க), அல்லது AV1 (அடுத்த தலைமுறை உயர் தரம்).</string>
    <string name="guide_orientation_desc">தானியங்கு, உருவப்படம் (செங்குத்து) அல்லது நிலப்பரப்பு (கிடைமட்ட) ஆகியவற்றிற்கு பதிவுசெய்யப்பட்ட வீடியோ விகிதங்களை பூட்டு.</string>
    <string name="guide_resolution_desc">உங்கள் திரையின் துல்லியமான தெளிவுத்திறனில் NATIVE படம் பிடிக்கிறது. 4K, 2K, FHD, HD மற்றும் SD லாக் பிடிப்பு நிலையான பரிமாணங்களுக்கு.</string>
    <string name="guide_fps_desc">நிலையான வீடியோ மென்மைக்காக 24-60 FPS வரம்பு. அதி-மென்மையான கேமிங் பிளேபேக்கிற்கு உயர் புதுப்பிப்பு வீத சாதனங்கள் 90-120 FPS ஐ ஆதரிக்கின்றன.</string>
    <string name="guide_bitrate_desc">Mbps இல் தரவு வேகத்தைக் குறிப்பிடுகிறது. அதிக மதிப்புகள் இயக்கத்தின் போது கூர்மையான விவரங்களைப் பிடிக்கின்றன, ஆனால் பெரிய வீடியோ கோப்புகளை விளைவிக்கும்.</string>
    <string name="guide_bitrate_mode_desc">VBR (மாறி பிட்ரேட்) சேமிப்பகத்தைச் சேமிக்க தரவு வீதத்தை மாறும் வகையில் அளவிடுகிறது. CBR (நிலையான பிட்ரேட்) இயக்கத்தைப் பொருட்படுத்தாமல் அதிக விவரங்களைக் கட்டாயப்படுத்துகிறது.</string>
    <string name="guide_audio_source_desc">இரண்டையும் ஒன்றாகப் பதிவுசெய்ய சைலன்ஸ் (ஆஃப்), மைக்ரோஃபோன் (எம்ஐசி), சிஸ்டம் இன்டர்னல் லூப்பேக் (எஸ்ஒய்எஸ்) அல்லது மிக்ஸ் (எஸ்ஒய்எஸ்+எம்ஐசி) ஆகியவற்றிலிருந்து தேர்வு செய்யவும்.</string>
    <string name="guide_audio_quality_desc">ஆடியோ மாதிரி வீதம் மற்றும் குறியாக்க பிட்ரேட் ஆகியவற்றை சரிசெய்யவும். உயர் அடுக்குகள் தூய்மையான, இரைச்சல் இல்லாத ஒலி விவரங்களை வழங்குகின்றன.</string>
    <string name="dialog_auto_orientation_title">⚠ ஆட்டோ நோக்குநிலை எச்சரிக்கை</string>
    <string name="dialog_auto_orientation_message">தானியங்கு நோக்குநிலை என்பது ஒரு வித்தை மற்றும் உங்கள் பதிவின் தரத்தைக் குறைக்கும்.\n\nஆண்ட்ராய்டு விர்ச்சுவல் டிஸ்ப்ளே மிட்-ரெக்கார்டிங்கை டைனமிக் முறையில் சுழற்றுகிறது, இது பெரும்பாலும் தெளிவுத்திறன் பொருத்தமின்மைகள், கருப்புப் பட்டைகள் மற்றும் குறியாக்கி உறுதியற்ற தன்மையை ஏற்படுத்துகிறது.\n\nஉங்கள் முதன்மையான நோக்குநிலையைப் பதிவுசெய்யும் வகையில் போர்ட்ரெய்ட் அல்லது லேண்ட்ஸ்கேப்பை கைமுறையாகத் தேர்ந்தெடுக்க பரிந்துரைக்கிறோம்.</string>
    <string name="dialog_auto_orientation_button_timer">எனக்கு புரிகிறது (%d)</string>
    <string name="dialog_auto_orientation_button">எனக்கு புரிகிறது</string>
    <string name="dialog_overlay_permission_title">மேலடுக்கு அனுமதி தேவை</string>
    <string name="dialog_overlay_permission_message">மிதக்கும் கன்ட்ரோலர் குமிழியைக் காட்ட, RecorderX க்கு மற்ற பயன்பாடுகளில் காட்ட அனுமதி தேவை. அடுத்த திரையில் அதை வழங்கவும்.</string>
