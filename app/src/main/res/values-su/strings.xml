    <string name="title_swipe_here">SWIPE IEUH</string>
    <string name="title_recorder">PANGRARAM</string>
    <string name="saved_in_path">Disimpen dina: /Movies/RecorderX</string>
    <string name="guide_codec_desc">H.264 (Paling cocog sareng pamaén séjén), H.265 (komprési kacida efisien), atawa AV1 (generasi saterusna kualitas luhur).</string>
    <string name="guide_orientation_desc">Konci rasio aspék video nu dirékam ka Otomatis, Potrét (vertikal), atawa Lansekap (horizontal).</string>
    <string name="guide_resolution_desc">NATIVE néwak dina résolusi tepat layar anjeun. 4K, 2K, FHD, HD, sareng SD lock candak kana ukuran standar.</string>
    <string name="guide_fps_desc">Kisaran 24-60 FPS pikeun lemes video standar. Alat laju refresh tinggi ngadukung 90-120 FPS pikeun playback kaulinan anu mulus pisan.</string>
    <string name="guide_bitrate_desc">Nangtukeun speed data dina Mbps. Nilai anu langkung luhur nyandak detil anu langkung seukeut salami gerakan tapi ngahasilkeun file video anu langkung ageung.</string>
    <string name="guide_bitrate_mode_desc">VBR (Variabel Bitrate) dinamis skala data laju pikeun nyimpen gudang. CBR (Constant Bitrate) maksakeun detil anu luhur henteu paduli gerakan.</string>
    <string name="guide_audio_source_desc">Pilih tina Jempé (OFF), Mikropon (MIC), System Internal Loopback (SYS), atanapi MIX (SYS+MIC) pikeun ngarékam duanana babarengan.</string>
    <string name="guide_audio_quality_desc">Saluyukeun laju sampel audio jeung bitrate encoding. Tingkat anu langkung luhur nyayogikeun detil sora anu langkung bersih, henteu bising.</string>
    <string name="dialog_auto_orientation_title">⚠ Perhatosan Orientasi Otomatis</string>
    <string name="dialog_auto_orientation_message">Oriéntasi Otomatis nyaéta gimmick sareng bakal ngarusak kualitas rékaman anjeun.\n\nAndroid sacara dinamis muterkeun tampilan virtual di tengah rekaman, sering nyababkeun resolusi anu teu cocog, bar hideung, sareng instability encoder.\n\nKami nyarankeun pisan milih Potrét atanapi Lanskap sacara manual pikeun cocog sareng orientasi utama aplikasi anu anjeun badé rekam — ieu ngahasilkeun kaluaran anu pangsaéna, paling konsisten.</string>
    <string name="dialog_auto_orientation_button_timer">Abdi Ngartos (%d)</string>
    <string name="dialog_auto_orientation_button">Abdi ngartos</string>
    <string name="dialog_overlay_permission_title">Idin Overlay Diperlukeun</string>
    <string name="dialog_overlay_permission_message">Pikeun mintonkeun gelembung controller ngambang, RecorderX perlu idin pikeun nembongkeun leuwih aktip séjén. Mangga nyanggakeun dina layar salajengna.</string>
    <string name="btn_grant">Hibah</string>
    <string name="btn_cancel">Ngabolaykeun</string>
    <string name="dialog_av1_software_title">⚠ Encoding Parangkat Lunak AV1</string>
    <string name="dialog_av1_software_message">Encoding hardware AV1 henteu dirojong dina alat ieu.\n\nNgarékam bakal dilakukeun nganggo Software AV1 (encoding CPU). Ieu tiasa nyababkeun paningkatan pamakean CPU, pamakean batre langkung luhur, sareng kamungkinan pigura turun dina resolusi anu langkung luhur.</string>
