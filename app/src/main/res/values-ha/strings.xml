    <!-- Auto-generated translations for all UI & guides -->
    <string name="title_swipe_here">SWIPE NAN</string>
    <string name="title_recorder">RUBUTU</string>
    <string name="saved_in_path">Ajiye a: /Fina-finai/RecorderX</string>
    <string name="guide_codec_desc">H.264 (Mafi dacewa tare da sauran \'yan wasa), H.265 (Matsi mai mahimmanci), ko AV1 (mai girma na gaba).</string>
    <string name="guide_orientation_desc">Makulle ma\'aunin yanayin bidiyo da aka yi rikodi zuwa Auto, Hoto (a tsaye), ko Tsarin ƙasa (a kwance).</string>
    <string name="guide_resolution_desc">Native yana ɗauka a ainihin ƙudurin allonku. 4K, 2K, FHD, HD, da kama kulle SD zuwa daidaitattun girma.</string>
    <string name="guide_fps_desc">Kewayon 24-60 FPS don daidaitaccen santsin bidiyo. Babban na\'urori masu wartsakewa suna goyan bayan 90-120 FPS don sake kunna wasan caca mai laushi.</string>
    <string name="guide_bitrate_desc">Yana ƙayyade saurin bayanai a cikin Mbps. Maɗaukakin ƙima yana ɗaukar cikakkun bayanai yayin motsi amma yana haifar da manyan fayilolin bidiyo.</string>
    <string name="guide_bitrate_mode_desc">VBR (Maɓallin Bitrate) yana daidaita ƙimar bayanai don adana ajiya. CBR (Constant Bitrate) yana ƙarfafa cikakkun bayanai ba tare da la\'akari da motsi ba.</string>
    <string name="guide_audio_source_desc">Zaɓi daga Shiru (KASHE), Makirifo (MIC), System Internal Loopback (SYS), ko MIX (SYS+MIC) don yin rikodin duka tare.</string>
    <string name="guide_audio_quality_desc">Daidaita ƙimar samfurin odiyo da ɓoye bitrate. Manyan matakai suna ba da mafi tsabta, cikakkun bayanan sauti marasa amo.</string>
    <string name="dialog_auto_orientation_title">⚠ Gargaɗi na Mota</string>
    <string name="dialog_auto_orientation_message">Hannun Hannun Auto ginshiƙi ne kuma zai ƙasƙantar da ingancin rikodin ku.\n\nAndroid yana jujjuya yanayin nunin tsakiyar rikodi, yawanci yana haifar da rashin daidaituwa, baƙaƙen sanduna, da rashin kwanciyar hankali.</string>
    <string name="dialog_auto_orientation_button_timer">Na fahimta (%d)</string>
    <string name="dialog_auto_orientation_button">Na gane</string>
    <string name="dialog_overlay_permission_title">Ana Bukatar Izinin Rubutu</string>
    <string name="dialog_overlay_permission_message">Don nuna kumfa mai sarrafa iyo, RecorderX yana buƙatar izini don nunawa akan wasu ƙa\'idodi. Da fatan za a ba shi akan allo na gaba.</string>
    <string name="btn_grant">Ba da izini</string>
    <string name="btn_cancel">Soke</string>
    <string name="dialog_av1_software_title">⚠ AV1 Software Encoding</string>
    <string name="dialog_av1_software_message">Ba a tallafawa rikodin rikodin Hardware AV1 akan wannan na\'urar.\n\nZa a yi rikodi ta amfani da Software AV1 (rufin rikodi na CPU). Wannan na iya haifar da ƙara yawan amfani da CPU, yawan amfani da baturi, da yuwuwar firam ɗin faɗuwa akan mafi girman ƙuduri.</string>
